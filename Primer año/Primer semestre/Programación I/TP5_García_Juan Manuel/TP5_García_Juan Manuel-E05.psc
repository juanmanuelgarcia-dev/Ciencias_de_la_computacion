Algoritmo asterisco
	definir tamaño,i,j Como Entero
	Escribir "Ingrese el tamaño del cuadro: "
	leer tamaño
	Escribir "****"
	para i <- 1 hasta tamaño con paso 1 Hacer
		para j <- 1 Hasta i con paso tamaño Hacer
			Escribir Sin Saltar "*"
		FinPara
		Escribir "  *"
	FinPara
	Escribir "****"
FinAlgoritmo
