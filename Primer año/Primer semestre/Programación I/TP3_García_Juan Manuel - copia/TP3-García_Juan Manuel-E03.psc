Algoritmo mayor_número
	definir A,B Como Real
	Escribir "Ingrese el primer número: "
	leer A
	Escribir "Ingrese el segundo número: "
	Leer B
	si A < B Entonces
		Mostrar "El número ",B," es mayor"
	SiNo
		si A > B Entonces
			Mostrar "El número ",A," es mayor"
		SiNo
			Mostrar "Los números ",A," y ",B," son iguales"
		FinSi
	FinSi
FinAlgoritmo
