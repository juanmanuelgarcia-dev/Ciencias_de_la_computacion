Algoritmo numero_romano
	definir num Como Entero
	Escribir "Ingrese un número entero del 1 al 10"
	leer num
	segun num Hacer
		Opcion 1: num = 1
			Mostrar "Equivale a I"
		Opcion 2: num = 2
			Mostrar "Equivale a II"
		Opcion 3: num = 3
			Mostrar "Equivale a III"
		Opcion 4: num = 4
			Mostrar "Equivale a IV"
		Opcion 5: num = 5
			Mostrar "Equivale a V"
		Opcion 6: num = 6
			Mostrar "Equivale a VI"
		Opcion 7: num = 7
			Mostrar "Equivale a VII"
		Opcion 8: num = 8
			Mostrar "Equivale a VIII"
		Opcion 9: num = 9
			Mostrar "Equivale a IX"
		Opcion 10: num = 10
			Mostrar "Equivale a X"
		De Otro Modo:
			Mostrar "Ingrese datos válidos"
	FinSegun
FinAlgoritmo
